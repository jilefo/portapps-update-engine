; ===========================================================================
; QQNTPortable  Custom.nsh   （UTF-8 无 BOM —— 带 BOM 会报 Invalid command）
; ===========================================================================
; [踩坑清单，勿重复 —— 详见 docs\踩坑记录.md]
;  1. 钩子宏名必须是 Custom.nsh_<阶段>（Segments.nsh L54），
;     写成 CustomPreExec / CustomInit 会**静默失效**；
;  2. Custom.nsh 必须放在 App\AppInfo\Launcher\ 且名字恰为 Custom.nsh；
;  3. $INSTDIR 在 PAL 启动器中未初始化（展开为空），路径一律 $EXEDIR 运行时拼接；
;  4. 拆 Junction 只能 rmdir（不带 /s），带 /s 会删穿联接误删 Data 数据；
;  5. 绝不联接共享/他软件目录；
;  6. NSIS 的 $APPDATA/$LOCALAPPDATA/$DOCUMENTS 常量读注册表 Shell Folders，
;     不受 PAL 改的进程环境影响 —— 宿主 junction 用它们即指真实宿主路径；
;  7. robocopy 合并宿主残留必须带 /XJ（不穿越联接），防止把他包 Data
;     经联接复制进本包（QQ/TIM/QQNT 共享 Documents\Tencent Files 场景）；
;  8. 接管已存在的 junction 前必须探针三路判定：本包残留直接接管 /
;     目标失效拆除重建 / 指向他处弹窗中止 —— 绝不抢接他包在用联接。
; ===========================================================================

!include "LogicLib.nsh"

; --- 判断路径是否为 reparse point（junction/symlink） --------------------
!macro NP_IsJunction _PATH _RESULT
    StrCpy $8 "${_PATH}"
    System::Call 'kernel32::GetFileAttributesW(t r8) i .r9'
    ${If} $9 == -1
        StrCpy ${_RESULT} "0"
    ${Else}
        IntOp $9 $9 & 0x400
        ${If} $9 == 0
            StrCpy ${_RESULT} "0"
        ${Else}
            StrCpy ${_RESULT} "1"
        ${EndIf}
    ${EndIf}
!macroend
!define NP_IsJunction `!insertmacro NP_IsJunction`

; --- helpers ps1：junction 探针 / 包内进程计数 / 残留清理 / Run 值清理 ----
; [2026-10-17 修复] 原实现用 nsExec 内联 powershell -Command，踩两重坑：
;   ① NSIS 把内联脚本里的 $l/$t/$p/$own 等当未声明变量吞掉（要 $$ 转义）；
;  ② PowerShell 5.1 -Command 的引号规则与预期不符（'' / "" 均 ParserError），
;   且原样还有 ^|（PS 不认 ^ 转义）。改为 FileWrite 生成 ps1 + -File 传参，
;   彻底绕开内联引号/转义地狱（probe_file_test 实测三段语义全对）。
!macro NP_WriteHelpers
  FileOpen $9 "$DataDirectory\settings\.np-helpers.ps1" w
  FileWrite $9 'param($$mode,$$a1,$$a2,$$a3,$$a4)$\r$\n'
  FileWrite $9 '$$ErrorActionPreference="SilentlyContinue"$\r$\n'
  FileWrite $9 'if($$mode -eq "probe"){$\r$\n'
  FileWrite $9 '$$p=".junc-probe-"+$$a3$\r$\n'
  FileWrite $9 '$$tp=Join-Path $$a2 $$p$\r$\n'
  FileWrite $9 'Set-Content -LiteralPath $$tp -Value "x" -Encoding ASCII$\r$\n'
  FileWrite $9 'if(Test-Path -LiteralPath (Join-Path $$a1 $$p)){Remove-Item -LiteralPath $$tp -Force;exit 0}$\r$\n'
  FileWrite $9 'Remove-Item -LiteralPath $$tp -Force$\r$\n'
  FileWrite $9 '$$li=Get-Item -LiteralPath $$a1 -Force$\r$\n'
  FileWrite $9 '$$lt=$$li.LinkTarget$\r$\n'
  FileWrite $9 'if(-not $$lt){$$lt=($$li.Target | Select-Object -First 1)}$\r$\n'
  FileWrite $9 'if(-not $$lt){exit 2}$\r$\n'
  FileWrite $9 'if(-not(Test-Path -LiteralPath $$lt)){exit 3}$\r$\n'
  FileWrite $9 '$$lt2=($$lt -replace [char]92+[char]63+[char]92,"")$\r$\n'
  FileWrite $9 '$$who=""$\r$\n'
  FileWrite $9 'if($$lt2 -like "*QQPortable*"){$$who="QQPortable"}$\r$\n'
  FileWrite $9 'elseif($$lt2 -like "*TIMPortable*"){$$who="TIMPortable"}$\r$\n'
  FileWrite $9 'elseif($$lt2 -like "*QQNTPortable*"){$$who="QQNTPortable"}$\r$\n'
  FileWrite $9 'else{exit 1}$\r$\n'
  FileWrite $9 'if(Get-Process -Name $$who -ErrorAction SilentlyContinue){exit 1}$\r$\n'
  FileWrite $9 'foreach($$a in @("QQ","Tim","QQNT")){if(Get-Process -Name $$a -ErrorAction SilentlyContinue){exit 1}}$\r$\n'
  FileWrite $9 'exit 3}$\r$\n'
  FileWrite $9 'exit 1}$\r$\n'
  FileWrite $9 'if($$mode -eq "count"){$\r$\n'
  FileWrite $9 '$$r=(Resolve-Path -LiteralPath $$a4).Path$\r$\n'
  FileWrite $9 '$$n=(Get-Process -ErrorAction SilentlyContinue | Where-Object {$$_.Path -and $$_.Path.StartsWith($$r,[System.StringComparison]::OrdinalIgnoreCase)}).Count$\r$\n'
  FileWrite $9 'Write-Output $$n$\r$\n'
  FileWrite $9 'exit 0}$\r$\n'
  FileWrite $9 'if($$mode -eq "kill"){$\r$\n'
  FileWrite $9 '$$r=(Resolve-Path -LiteralPath $$a4).Path$\r$\n'
  FileWrite $9 'Get-Process -ErrorAction SilentlyContinue | Where-Object {$$_.Path -and $$_.Path.StartsWith($$r,[System.StringComparison]::OrdinalIgnoreCase)} | ForEach-Object {try{Stop-Process -Id $$_.Id -Force -ErrorAction SilentlyContinue}catch{}}$\r$\n'
  FileWrite $9 'exit 0}$\r$\n'
  FileWrite $9 'if($$mode -eq "runclean"){$\r$\n'
  FileWrite $9 '$$k="HKCU:\Software\Microsoft\Windows\CurrentVersion\Run"$\r$\n'
  FileWrite $9 '$$v=(Get-ItemProperty -Path $$k -Name $$a4 -ErrorAction SilentlyContinue).$$a4$\r$\n'
  FileWrite $9 'if($$v -and $$v.StartsWith($$a3,[System.StringComparison]::OrdinalIgnoreCase)){Remove-ItemProperty -Path $$k -Name $$a4 -Force}$\r$\n'
  FileWrite $9 'exit 0}$\r$\n'
  FileWrite $9 'exit 99$\r$\n'
  FileClose $9
!macroend
!define NP_WriteHelpers `!insertmacro NP_WriteHelpers`

; --- 探针三路判定返回码（约定，勿改） ----------------------------------------
;   0 = 宿主 junction 已指向本包 Data（崩溃残留），直接接管
;   3 = junction 目标已失效（陈旧联接），拆除后重建
;   其他 = 指向他处且存活（他包正在使用同一宿主目录），弹窗说明并中止启动
!macro NP_JunctionProbe _HOST _TARGET _TAG _RESULT
    nsExec::ExecToStack 'powershell -NoProfile -ExecutionPolicy Bypass -File "$DataDirectory\settings\.np-helpers.ps1" probe "${_HOST}" "${_TARGET}" "${_TAG}" ""'
    Pop ${_RESULT}
    Pop $9
!macroend
!define NP_JunctionProbe `!insertmacro NP_JunctionProbe`

; --- 建立 junction（幂等；探针防抢接；宿主实目录先合并回 Data 再强删） -----
!macro NP_JunctionCreate _HOST _TARGET _TAG
    StrCpy $8 ""
    ${If} ${FileExists} "${_HOST}"
        ${NP_IsJunction} "${_HOST}" $7
        ${If} $7 == "1"
            CreateDirectory "${_TARGET}"
            ${NP_JunctionProbe} "${_HOST}" "${_TARGET}" "${_TAG}" $8
            ${If} $8 == "0"
                ; 本包既有 junction（崩溃残留），直接接管
            ${ElseIf} $8 == "3"
                nsExec::ExecToLog 'cmd /c rmdir "${_HOST}"'
            ${Else}
                MessageBox MB_ICONSTOP|MB_OK "便携启动中止：$\r$\n${_HOST}$\r$\n已是目录联接且指向其他位置（可能另一便携软件正在使用同一宿主目录，或宿主存在冲突联接）。$\r$\n请关闭相关软件、删除该联接后重试。"
                Quit
            ${EndIf}
        ${Else}
            ; 宿主真实目录（正式版数据或历次泄漏残留）：合并回 Data 再移除，不丢数据
            nsExec::ExecToLog 'cmd /c robocopy "${_HOST}" "${_TARGET}" /E /XO /XJ /NFL /NDL /NJH /NJS'
            nsExec::ExecToLog 'cmd /c attrib -R -S -H "${_HOST}\*" /S /D'
            nsExec::ExecToLog 'cmd /c del /f /s /q "${_HOST}\*" >nul 2>nul'
            nsExec::ExecToLog 'cmd /c rmdir /s /q "${_HOST}"'
            ${If} ${FileExists} "${_HOST}"
                nsExec::ExecToLog 'cmd /c robocopy "${_HOST}" "${_TARGET}" /E /XO /XJ /NFL /NDL /NJH /NJS'
                nsExec::ExecToLog 'cmd /c attrib -R -S -H "${_HOST}\*" /S /D'
                nsExec::ExecToLog 'cmd /c del /f /s /q "${_HOST}\*" >nul 2>nul'
                nsExec::ExecToLog 'cmd /c rmdir /s /q "${_HOST}"'
            ${EndIf}
        ${EndIf}
    ${EndIf}
    ${If} $8 == "0"
        ; 已接管既有 junction，无需建链
    ${ElseIf} ${FileExists} "${_HOST}"
        ; 宿主目录强删失败（文件被他进程内存映射）：写阻塞标记并放弃，绝不静默继续
        FileOpen $9 "$DataDirectory\settings\junction-blocked-${_TAG}.log" w
        ${If} $9 != ""
            FileWrite $9 'Junction blocked: host directory could not be removed (files locked by another process).$\r$\nHost: ${_HOST}$\r$\nTarget: ${_TARGET}$\r$\n'
            FileClose $9
        ${EndIf}
    ${Else}
        CreateDirectory "${_TARGET}"
        nsExec::ExecToLog 'cmd /c mklink /J "${_HOST}" "${_TARGET}"'
        ; 建链失败（如断裂旧联接占名）必须留证据，绝不静默继续
        ${NP_IsJunction} "${_HOST}" $7
        ${If} $7 != "1"
            FileOpen $9 "$DataDirectory\settings\junction-blocked-${_TAG}.log" w
            ${If} $9 != ""
                FileWrite $9 'Junction blocked: mklink failed (stale reparse point may occupy the name).$\r$\nHost: ${_HOST}$\r$\nTarget: ${_TARGET}$\r$\n'
                FileClose $9
            ${EndIf}
        ${EndIf}
    ${EndIf}
!macroend
!define NP_JunctionCreate `!insertmacro NP_JunctionCreate`

; --- 启动前主动回收宿主 junction 废墟 ----------------------------------------
; 上次启动若中止/崩溃，宿主侧会留下指向本包 Data 的 junction（启动器已退、
; PostPrimary 永不执行）。此处只做「判定为本包所有即 rmdir 拆链」，绝不触碰
; 真实目录——真实目录的合并/强删逻辑仍在 NP_JunctionCreate 内，行为不变。
; 调用顺序必须在 createjunc 之前：先清废墟，后续建链分支才能命中
; FileExists==false → mklink 的正常路径。
!macro NP_JunctionScavenge _HOST _TARGET _TAG
    ${If} ${FileExists} "${_HOST}"
        ${NP_IsJunction} "${_HOST}" $7
        ${If} $7 == "1"
            CreateDirectory "${_TARGET}"
            ${NP_JunctionProbe} "${_HOST}" "${_TARGET}" "${_TAG}" $8
            ${If} $8 == "0"
                nsExec::ExecToLog 'cmd /c rmdir "${_HOST}"'
            ${ElseIf} $8 == "3"
                nsExec::ExecToLog 'cmd /c rmdir "${_HOST}"'
            ${EndIf}
        ${EndIf}
    ${EndIf}
!macroend
!define NP_JunctionScavenge `!insertmacro NP_JunctionScavenge`

!macro NP_JunctionRemove _HOST
    ${If} ${FileExists} "${_HOST}"
        ${NP_IsJunction} "${_HOST}" $7
        ${If} $7 == "1"
            nsExec::ExecToLog 'cmd /c rmdir "${_HOST}"'
        ${EndIf}
    ${EndIf}
!macroend
!define NP_JunctionRemove `!insertmacro NP_JunctionRemove`

; --- Run 自启值清理（仅当值数据指向本包内路径才删，防误删宿主安装版） ------
!macro NP_RunCleanup _NAME
    nsExec::ExecToStack 'powershell -NoProfile -ExecutionPolicy Bypass -File "$DataDirectory\settings\.np-helpers.ps1" runclean "" "" "$EXEDIR" "${_NAME}"'
    Pop $8
    Pop $9
!macroend
!define NP_RunCleanup `!insertmacro NP_RunCleanup`

; --- 收尾重试：主程序退出后仍有后台线程/崩溃报告进程短暂存活 ---------------
; PAL PostPrimary 在主程序进程返回后立即触发，此时 QQ 系的崩溃报告/遥测
; 线程仍可能持有注册表键句柄（registry::DeleteKey/SaveKey 对占用键失败）。
; 此处轮询至包内进程全部消失（上限 ~15s）再拆链/回存，保证注册表与
; junction 收尾零残留。轮询间隔 500ms。
Function WaitPkgGone
  StrCpy $6 0
  ${Do}
    nsExec::ExecToStack 'powershell -NoProfile -ExecutionPolicy Bypass -File "$DataDirectory\settings\.np-helpers.ps1" count "" "" "" "$EXEDIR\App"'
    Pop $7
    Pop $9
    ${If} $7 == "0"
      ${ExitDo}
    ${EndIf}
    IntOp $6 $6 + 1
    ${If} $6 >= 30
      ${ExitDo}
    ${EndIf}
    Sleep 500
  ${Loop}
FunctionEnd

; --- 结束便携目录内的后台残留进程（按路径限定，绝不按映像名全局杀） ------
Function KillResidual
  nsExec::ExecToStack 'powershell -NoProfile -ExecutionPolicy Bypass -File "$DataDirectory\settings\.np-helpers.ps1" kill "" "" "" "$EXEDIR\App"'
  Pop $0
  Pop $1
FunctionEnd

; ===========================================================================
; PAL 钩子（宏名必须是 Custom.nsh_<阶段>）
; ===========================================================================

!macro Custom.nsh_PreExecPrimary
  ClearErrors
  ${NP_WriteHelpers}
  ReadEnvStr $5 "ProgramData"
  CreateDirectory "$DataDirectory\settings"
  CreateDirectory "$DataDirectory\settings\local"
  CreateDirectory "$DataDirectory\settings\Temp"
  CreateDirectory "$DataDirectory\settings\QQ"
  CreateDirectory "$DataDirectory\settings\Tencent\QQNT"
  CreateDirectory "$DataDirectory\settings\Tencent\QQ"
  CreateDirectory "$DataDirectory\documents\Tencent Files"
  CreateDirectory "$DataDirectory\settings\ProgramData\Tencent\qimei"
  CreateDirectory "$DataDirectory\settings\ProgramData\xfolder"

  ; 环境变量双保险（对 getenv 组件生效；Junction 之外的补充）
  System::Call 'kernel32::SetEnvironmentVariable(t, t)i' 'APPDATA' '$DataDirectory\settings'
  System::Call 'kernel32::SetEnvironmentVariable(t, t)i' 'LOCALAPPDATA' '$DataDirectory\settings\local'
  System::Call 'kernel32::SetEnvironmentVariable(t, t)i' 'TEMP' '$DataDirectory\settings\Temp'
  System::Call 'kernel32::SetEnvironmentVariable(t, t)i' 'TMP' '$DataDirectory\settings\Temp'

  CreateDirectory "$5\Tencent"
  ${NP_JunctionScavenge} "$APPDATA\QQ" "$DataDirectory\settings\QQ" "APPDATA_QQ_0"
  ${NP_JunctionScavenge} "$APPDATA\Tencent\QQNT" "$DataDirectory\settings\Tencent\QQNT" "APPDATA_Tencent_QQNT_1"
  ${NP_JunctionScavenge} "$APPDATA\Tencent\QQ" "$DataDirectory\settings\Tencent\QQ" "APPDATA_Tencent_QQ_2"
  ${NP_JunctionScavenge} "$DOCUMENTS\Tencent Files" "$DataDirectory\documents\Tencent Files" "DOCUMENTS_Tencent_Files_3"
  ${NP_JunctionScavenge} "$5\Tencent\qimei" "$DataDirectory\settings\ProgramData\Tencent\qimei" "5_Tencent_qimei_4"
  ${NP_JunctionScavenge} "$5\xfolder" "$DataDirectory\settings\ProgramData\xfolder" "5_xfolder_5"
  ${NP_JunctionCreate} "$APPDATA\QQ" "$DataDirectory\settings\QQ" "APPDATA_QQ_0"
  ${NP_JunctionCreate} "$APPDATA\Tencent\QQNT" "$DataDirectory\settings\Tencent\QQNT" "APPDATA_Tencent_QQNT_1"
  ${NP_JunctionCreate} "$APPDATA\Tencent\QQ" "$DataDirectory\settings\Tencent\QQ" "APPDATA_Tencent_QQ_2"
  ${NP_JunctionCreate} "$DOCUMENTS\Tencent Files" "$DataDirectory\documents\Tencent Files" "DOCUMENTS_Tencent_Files_3"
  ${NP_JunctionCreate} "$5\Tencent\qimei" "$DataDirectory\settings\ProgramData\Tencent\qimei" "5_Tencent_qimei_4"
  ${NP_JunctionCreate} "$5\xfolder" "$DataDirectory\settings\ProgramData\xfolder" "5_xfolder_5"

  ${NP_RunCleanup} "QQNT"
!macroend

!macro Custom.nsh_PostPrimary
  ${NP_WriteHelpers}
  ReadEnvStr $5 "ProgramData"
  Call WaitPkgGone
  Call KillResidual
  ${NP_JunctionRemove} "$APPDATA\QQ"
  ${NP_JunctionRemove} "$APPDATA\Tencent\QQNT"
  ${NP_JunctionRemove} "$APPDATA\Tencent\QQ"
  ${NP_JunctionRemove} "$DOCUMENTS\Tencent Files"
  ${NP_JunctionRemove} "$5\Tencent\qimei"
  ${NP_JunctionRemove} "$5\xfolder"
  nsExec::ExecToLog 'cmd /c rmdir "$5\Tencent"'
  ${NP_RunCleanup} "QQNT"
!macroend

!macro Custom.nsh_Unload
  ${NP_WriteHelpers}
  ReadEnvStr $5 "ProgramData"
  Call WaitPkgGone
  Call KillResidual
  ${NP_JunctionRemove} "$APPDATA\QQ"
  ${NP_JunctionRemove} "$APPDATA\Tencent\QQNT"
  ${NP_JunctionRemove} "$APPDATA\Tencent\QQ"
  ${NP_JunctionRemove} "$DOCUMENTS\Tencent Files"
  ${NP_JunctionRemove} "$5\Tencent\qimei"
  ${NP_JunctionRemove} "$5\xfolder"
  nsExec::ExecToLog 'cmd /c rmdir "$5\Tencent"'
  ${NP_RunCleanup} "QQNT"
!macroend
